body{
  margin:0;
  font-family:'Playfair Display',serif;
  background:#0b1f2a;
  color:#f5faff;
}

/* CAPA */
header{
  height:90vh;
  background:
    linear-gradient(rgba(5,15,30,0.75),rgba(5,15,30,0.9)),
    url("IMG-20260204-WA0025.jpg");
  background-size:cover;
  background-position:center;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
}

/* TÍTULO COM AURA */
header h1{
  font-family:'Cinzel',serif;
  font-size:3rem;
  letter-spacing:4px;
  position:relative;
  margin:0;
}

header h1::after{
  content:"";
  position:absolute;
  left:50%;
  top:50%;
  width:150%;
  height:170%;
  background:radial-gradient(circle,
    rgba(180,220,255,0.35),
    rgba(180,220,255,0.12),
    transparent);
  transform:translate(-50%,-50%);
  filter:blur(28px);
  z-index:-1;
}

header p{
  margin-top:12px;
  opacity:.9;
}

/* SEÇÕES */
section{
  max-width:1000px;
  margin:auto;
  padding:50px 20px;
}

h2{
  font-family:'Cinzel',serif;
  text-align:center;
  margin-bottom:30px;
  letter-spacing:2px;
}

/* GRID */
.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
  gap:22px;
}

/* CARD */
.card{
  background:rgba(255,255,255,.06);
  border:1px solid rgba(255,255,255,.15);
  border-radius:14px;
  padding:22px;
  text-align:center;
  cursor:pointer;
  transition:.3s;
}

.card:hover{
  transform:translateY(-6px);
  box-shadow:0 0 20px rgba(160,210,255,.3);
}

.card h3{
  font-family:'Cinzel',serif;
  margin-bottom:8px;
}

.preco{
  font-size:1.1rem;
  font-weight:bold;
  color:#b6e0ff;
}

/* WHATSAPP */
.whatsapp{
  position:fixed;
  bottom:20px;
  right:20px;
  background:#25d366;
  color:white;
  padding:14px 18px;
  border-radius:50px;
  text-decoration:none;
  font-weight:bold;
}

footer{
  text-align:center;
  padding:30px;
  font-size:13px;
  opacity:.6;
}
</style>
</head>

